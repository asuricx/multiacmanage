# Telegram API Credentials (my.telegram.org)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Admin Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCDefGhIJklMnOpQrStUvWxYz

# Comma-separated Telegram User IDs allowed to access the admin panel
ADMIN_IDS=123456789,987654321

# Database Configuration (PostgreSQL Async)
POSTGRES_USER=userbot
POSTGRES_PASSWORD=userbot_secret_password
POSTGRES_DB=userbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://userbot:userbot_secret_password@postgres:5432/userbot_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Optional Proxy Scraper Default Settings
AUTO_ROTATE_PROXY=true
PROXY_HEALTH_CHECK_TIMEOUT=5

# Database Backup Settings
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups
# BACKUP_CHAT_ID=123456789
